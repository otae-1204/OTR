{
  "$schema": "https://raw.githubusercontent.com/otae-1204/OTR/main/docs/theme.schema.json",
  "apiVersion": 1,
  "id": "fjord",
  "name": "北境 Fjord",
  "version": "1.0.0",
  "author": "OTR 示例主题",
  "description": "只有暗色的示例主题:极夜石板蓝底、霜白正文、冰川青主色,低饱和的极光色图表;干净的无衬线字体与中等圆角,顶栏毛玻璃、统计卡的极光微光与进度条的冰面高光。",
  "homepage": "https://github.com/otae-1204/OTR",
  "tokens": {
    "font": {
      "sans": "Inter, \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "mono": "Iosevka, \"Fira Code\", \"Cascadia Mono\", Menlo, Consolas, monospace"
    },
    "radius": { "md": "0.375rem", "lg": "0.625rem", "xl": "0.75rem" },
    "css": {
      "card-title": { "font-weight": "500", "letter-spacing": "0.05em" },
      "page-title": { "font-weight": "500", "letter-spacing": "0.06em" }
    }
  },
  "modes": {
    "dark": {
      "colors": {
        "background": "#252b36",
        "foreground": "#e5e9f0",
        "card": "#2c3340",
        "cardForeground": "#e5e9f0",
        "popover": "#313946",
        "popoverForeground": "#e5e9f0",
        "primary": "#88c0d0",
        "primaryForeground": "#1d232d",
        "secondary": "#3a4352",
        "secondaryForeground": "#e5e9f0",
        "muted": "#3a4352",
        "mutedForeground": "#b4bdcc",
        "accent": "#3e4a5c",
        "accentForeground": "#e5e9f0",
        "destructive": "#e88f98",
        "destructiveForeground": "#1d232d",
        "border": "#434d5f",
        "input": "#4f5b70",
        "ring": "#92b4e3",
        "overlay": "#d8e6f5",
        "success": "#a8cc8f",
        "warning": "#e9cd8c",
        "danger": "#efa4ab",
        "info": "#92b4e3",
        "notice": "#e3ac8f",
        "successText": "#bfe0a9",
        "warningText": "#f0d9a4",
        "dangerText": "#f3b3b9",
        "successLabel": "#b2d49a",
        "warningLabel": "#ebcf8e",
        "dangerLabel": "#f0a8ae",
        "switchThumb": "#252b36",
        "switchThumbOff": "#e5e9f0"
      },
      "stat": {
        "input": "#8fb3e8",
        "output": "#c3a2c8",
        "cacheRead": "#93c8c6",
        "cacheWrite": "#e4c586",
        "calls": "#88c0d0",
        "cost": "#b0d19a"
      },
      "chart": {
        "palette": ["#88c0d0", "#c09bbd", "#a9c893", "#d99a7a", "#e6c98e", "#93c3c1", "#8aaad0", "#d98a93", "#9aa5b8"],
        "agents": {
          "dsh": "#c09bbd",
          "claude-code": "#d99a7a",
          "codex": "#8aaad0",
          "zcode": "#a9c893",
          "opencode": "#88c0d0",
          "pi": "#d98aa8",
          "cursor": "#aab3c2"
        },
        "agentFallback": ["#d98aa8", "#d99a7a", "#a9c893", "#c09bbd", "#93c3c1", "#e6c98e"]
      },
      "shadow": {
        "sm": "0 1px 2px 0 rgba(12, 16, 24, 0.30)",
        "base": "0 1px 3px 0 rgba(12, 16, 24, 0.45), 0 1px 2px -1px rgba(12, 16, 24, 0.30)",
        "md": "0 10px 24px -10px rgba(10, 14, 22, 0.65), 0 0 0 1px rgba(136, 192, 208, 0.35)",
        "lg": "0 18px 40px -14px rgba(10, 14, 22, 0.75), 0 0 0 1px rgba(146, 180, 227, 0.18)"
      },
      "css": {
        "header": {
          "background-image": "linear-gradient(180deg, rgba(44, 51, 64, 0.85) 0%, rgba(37, 43, 54, 0.65) 100%)",
          "backdrop-filter": "blur(14px) saturate(1.3)"
        },
        "stat-card": {
          "background-image": "linear-gradient(115deg, rgba(136, 192, 208, 0.12) 0%, rgba(192, 155, 189, 0.07) 45%, rgba(169, 200, 147, 0) 80%)"
        },
        "progress-fill": {
          "background-image": "linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.28) 100%)"
        },
        "chip:selected": { "border-color": "hsl(var(--primary) / 0.8)" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/otae-1204/OTR/docs/theme.schema.json",
  "title": "OTR theme manifest (apiVersion 1)",
  "description": "OTR(Otae's Token Radar)主题清单。放在 <应用数据目录>/themes/<name>.json 或 themes/<name>/theme.json。详见 docs/theme_interface.md。",
  "type": "object",
  "required": ["apiVersion", "id", "name", "modes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": {
      "type": "integer",
      "const": 1,
      "description": "主题格式版本。当前为 1。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "唯一 id:小写字母/数字开头,允许 - _ .,最长 64。不能是内置主题的 id(otr)。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "description": "展示名" },
    "version": { "type": "string", "maxLength": 32, "description": "主题自己的版本号,仅展示" },
    "author": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 200 },
    "homepage": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https?://",
      "description": "仅作文本展示,应用不会访问它"
    },
    "tokens": {
      "$ref": "#/definitions/tokens",
      "description": "与深浅模式无关的公共 token(字体、圆角、图表调色板等;颜色也可以放这里)"
    },
    "modes": {
      "type": "object",
      "description": "按模式的 token。至少提供 dark 或 light 其中之一;缺的模式在应用里不可选。",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "dark": { "$ref": "#/definitions/tokens" },
        "light": { "$ref": "#/definitions/tokens" }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "description": "不透明颜色:#rgb / #rrggbb / rgb() / hsl() / 裸 HSL 三元组 \"240 5% 12%\"。不接受颜色关键字,不接受透明度。",
      "pattern": "^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{4}|#[0-9a-fA-F]{8}|rgba?\\(.*\\)|hsla?\\(.*\\)|-?[0-9.]+\\s+-?[0-9.]+%\\s+-?[0-9.]+%)$"
    },
    "colorList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/color" }
    },
    "length": {
      "type": "string",
      "pattern": "^(0|(\\d+(\\.\\d+)?|\\.\\d+)(px|rem|em))$",
      "description": "0 或带 px/rem/em 的非负数(px ≤ 128,rem/em ≤ 8)"
    },
    "shadow": {
      "type": "string",
      "maxLength": 200,
      "description": "none,或逗号分隔的若干层:[inset] 2–4 个长度 [颜色];颜色可带透明度"
    },
    "fontFamily": {
      "type": "string",
      "maxLength": 200,
      "description": "逗号分隔的字体族;只允许字母/数字/空格/引号/逗号/连字符/下划线/点(含中文)"
    },
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "属性值。只允许字母、数字、空格、- + . % # ( ) , /(font-family 另允许引号与 Unicode 字母);没有分号、花括号、!important、url()、@import。"
    },
    "cssBlock": {
      "type": "object",
      "description": "一个钩子上的声明:属性 → 值(属性白名单如下,每个钩子最多 24 条)",
      "additionalProperties": false,
      "maxProperties": 24,
      "properties": {
        "color": { "$ref": "#/definitions/cssValue", "description": "文字色:#hex / rgb() / hsl() / transparent / currentColor / hsl(var(--语义色) [/ 透明度]) / var(--chart-N|--agent-id)" },
        "background-color": { "$ref": "#/definitions/cssValue", "description": "背景色,同 color 的语法" },
        "background-image": { "$ref": "#/definitions/cssValue", "description": "none,或最多 4 个 linear-gradient() / radial-gradient()(只含颜色、长度/百分比、角度、方位关键字),每个 2–16 个色标" },
        "background-clip": { "$ref": "#/definitions/cssValue", "description": "border-box / padding-box / content-box / text(同时写出 -webkit- 前缀;配合渐变 + color: transparent 做渐变文字)" },
        "border": { "$ref": "#/definitions/cssValue", "description": "[宽度 ≤ 8px] [none|solid|dashed|dotted|double] [颜色],任意顺序;或 none" },
        "border-top": { "$ref": "#/definitions/cssValue", "description": "同 border" },
        "border-right": { "$ref": "#/definitions/cssValue", "description": "同 border" },
        "border-bottom": { "$ref": "#/definitions/cssValue", "description": "同 border" },
        "border-left": { "$ref": "#/definitions/cssValue", "description": "同 border" },
        "border-color": { "$ref": "#/definitions/cssValue", "description": "1–4 个颜色" },
        "border-top-color": { "$ref": "#/definitions/cssValue", "description": "颜色" },
        "border-right-color": { "$ref": "#/definitions/cssValue", "description": "颜色" },
        "border-bottom-color": { "$ref": "#/definitions/cssValue", "description": "颜色" },
        "border-left-color": { "$ref": "#/definitions/cssValue", "description": "颜色" },
        "border-width": { "$ref": "#/definitions/cssValue", "description": "1–4 个长度,每个 ≤ 8px / 0.5rem" },
        "border-top-width": { "$ref": "#/definitions/cssValue", "description": "长度 ≤ 8px" },
        "border-right-width": { "$ref": "#/definitions/cssValue", "description": "长度 ≤ 8px" },
        "border-bottom-width": { "$ref": "#/definitions/cssValue", "description": "长度 ≤ 8px" },
        "border-left-width": { "$ref": "#/definitions/cssValue", "description": "长度 ≤ 8px" },
        "border-style": { "$ref": "#/definitions/cssValue", "description": "1–4 个 none|solid|dashed|dotted|double" },
        "border-top-style": { "$ref": "#/definitions/cssValue", "description": "none|solid|dashed|dotted|double" },
        "border-right-style": { "$ref": "#/definitions/cssValue", "description": "同 border-top-style" },
        "border-bottom-style": { "$ref": "#/definitions/cssValue", "description": "同 border-top-style" },
        "border-left-style": { "$ref": "#/definitions/cssValue", "description": "同 border-top-style" },
        "border-radius": { "$ref": "#/definitions/cssValue", "description": "1–4 个长度/百分比(≤ 1000px / 64rem / 100%),或 var(--radius-md|lg|xl)" },
        "border-top-left-radius": { "$ref": "#/definitions/cssValue", "description": "1–2 个长度/百分比" },
        "border-top-right-radius": { "$ref": "#/definitions/cssValue", "description": "1–2 个长度/百分比" },
        "border-bottom-right-radius": { "$ref": "#/definitions/cssValue", "description": "1–2 个长度/百分比" },
        "border-bottom-left-radius": { "$ref": "#/definitions/cssValue", "description": "1–2 个长度/百分比" },
        "outline-color": { "$ref": "#/definitions/cssValue", "description": "颜色(焦点环)" },
        "opacity": { "$ref": "#/definitions/cssValue", "description": "0–1 或 0–100%" },
        "font-weight": { "$ref": "#/definitions/cssValue", "description": "normal / bold / lighter / bolder 或 1–1000 的整数" },
        "font-style": { "$ref": "#/definitions/cssValue", "description": "normal / italic / oblique" },
        "letter-spacing": { "$ref": "#/definitions/cssValue", "description": "normal 或长度(±8px / ±0.5em)" },
        "text-transform": { "$ref": "#/definitions/cssValue", "description": "none / uppercase / lowercase / capitalize" },
        "text-decoration-line": { "$ref": "#/definitions/cssValue", "description": "none 或 underline / overline / line-through(最多两个)" },
        "text-decoration-style": { "$ref": "#/definitions/cssValue", "description": "solid / double / dotted / dashed / wavy" },
        "text-decoration-color": { "$ref": "#/definitions/cssValue", "description": "颜色" },
        "backdrop-filter": { "$ref": "#/definitions/cssValue", "description": "none,或最多 3 个 blur(≤ 40px) / saturate() / brightness() / contrast()(0–3 或 0–300%);同时写出 -webkit- 前缀" },
        "font-family": { "$ref": "#/definitions/cssValue", "description": "与 font token 同样的字体族语法,或 var(--font-sans|--font-mono)" },
        "box-shadow": { "$ref": "#/definitions/cssValue", "description": "与 shadow token 同样的语法(颜色须是字面量),或 var(--shadow|--shadow-sm|md|lg)" },
        "text-shadow": { "$ref": "#/definitions/cssValue", "description": "逗号分隔的若干层:2–3 个长度 [颜色];不允许 inset" },
        "font-size": { "type": "string", "maxLength": 256, "pattern": "^\\s*\\+?(0?\\.[89]\\d*|1(\\.[01]\\d*|\\.2(0*))?)(em|EM|Em|eM)\\s*$|^\\s*\\+?(8\\d(\\.\\d+)?|9\\d(\\.\\d+)?|1[01]\\d(\\.\\d+)?|120(\\.0+)?)%\\s*$", "description": "相对组件原字号的倍率:0.8em–1.2em 或 80%–120%(±20%)。不接受 px / rem / calc() / var() / 关键字。应用把它写成钩子上的倍率变量,每个元素按自己原来的字号缩放,嵌套钩子不累乘" },
        "line-height": { "type": "string", "maxLength": 256, "pattern": "^\\s*\\+?(0?\\.[89]\\d*|1(\\.[01]\\d*|\\.2(0*))?)\\s*$|^\\s*\\+?(8\\d(\\.\\d+)?|9\\d(\\.\\d+)?|1[01]\\d(\\.\\d+)?|120(\\.0+)?)%\\s*$", "description": "相对组件原行高的倍率:无单位 0.8–1.2 或 80%–120%(±20%;注意不是 CSS 里「字号的几倍」)。不接受 em / px / normal / calc() / var()" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "$ref": "#/definitions/color" },
            "foreground": { "$ref": "#/definitions/color" },
            "card": { "$ref": "#/definitions/color" },
            "cardForeground": { "$ref": "#/definitions/color" },
            "popover": { "$ref": "#/definitions/color" },
            "popoverForeground": { "$ref": "#/definitions/color" },
            "primary": { "$ref": "#/definitions/color" },
            "primaryForeground": { "$ref": "#/definitions/color" },
            "secondary": { "$ref": "#/definitions/color" },
            "secondaryForeground": { "$ref": "#/definitions/color" },
            "muted": { "$ref": "#/definitions/color" },
            "mutedForeground": { "$ref": "#/definitions/color" },
            "accent": { "$ref": "#/definitions/color" },
            "accentForeground": { "$ref": "#/definitions/color" },
            "destructive": { "$ref": "#/definitions/color" },
            "destructiveForeground": { "$ref": "#/definitions/color" },
            "border": { "$ref": "#/definitions/color" },
            "input": { "$ref": "#/definitions/color" },
            "ring": { "$ref": "#/definitions/color" },
            "overlay": { "$ref": "#/definitions/color" },
            "success": { "$ref": "#/definitions/color", "description": "状态填充色:进度条、开关「开」轨道(不再直接当文字用,文字见 successLabel)" },
            "warning": { "$ref": "#/definitions/color", "description": "状态填充色:进度条(文字见 warningLabel)" },
            "danger": { "$ref": "#/definitions/color", "description": "状态填充色:进度条(文字见 dangerLabel / dangerText)" },
            "info": { "$ref": "#/definitions/color" },
            "notice": { "$ref": "#/definitions/color" },
            "successText": { "$ref": "#/definitions/color" },
            "warningText": { "$ref": "#/definitions/color" },
            "dangerText": { "$ref": "#/definitions/color" },
            "successLabel": { "$ref": "#/definitions/color", "description": "卡片上的独立状态文字(额度剩余 ≥50%、「缓存命中率」标题、保存成功提示)。可选,缺省回退到本主题写了的 success,再回退默认主题" },
            "warningLabel": { "$ref": "#/definitions/color", "description": "卡片上的独立状态文字(额度剩余 25–50%、定价「手动」标签、Agent 卡 ⚠)。可选,缺省回退到本主题写了的 warning,再回退默认主题" },
            "dangerLabel": { "$ref": "#/definitions/color", "description": "卡片上的独立状态文字(额度剩余 <25%)。可选,缺省回退到本主题写了的 dangerText,再回退默认主题" },
            "switchThumb": { "$ref": "#/definitions/color", "description": "设置页开关「开」态的滑块(轨道是 success)。可选,缺省回退到本主题写了的 primaryForeground,再回退默认主题(白)" },
            "switchThumbOff": { "$ref": "#/definitions/color", "description": "设置页开关「关」态的滑块(轨道是 mutedForeground 30% 叠在卡片上)。可选,缺省回退到本主题写了的 switchThumb,再回退默认主题(暗色白、亮色 zinc-500;不再沿用 primaryForeground)" }
          }
        },
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": { "$ref": "#/definitions/color" },
            "output": { "$ref": "#/definitions/color" },
            "cacheRead": { "$ref": "#/definitions/color" },
            "cacheWrite": { "$ref": "#/definitions/color" },
            "calls": { "$ref": "#/definitions/color" },
            "cost": { "$ref": "#/definitions/color" }
          }
        },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "palette": { "$ref": "#/definitions/colorList" },
            "agents": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "additionalProperties": { "$ref": "#/definitions/color" }
            },
            "agentFallback": { "$ref": "#/definitions/colorList" }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sans": { "$ref": "#/definitions/fontFamily" },
            "mono": { "$ref": "#/definitions/fontFamily" }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "md": { "$ref": "#/definitions/length" },
            "lg": { "$ref": "#/definitions/length" },
            "xl": { "$ref": "#/definitions/length" }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sm": { "$ref": "#/definitions/shadow" },
            "base": { "$ref": "#/definitions/shadow" },
            "md": { "$ref": "#/definitions/shadow" },
            "lg": { "$ref": "#/definitions/shadow" }
          }
        },
        "css": {
          "type": "object",
          "description": "受限自定义 CSS(apiVersion 1 内新增的可选字段)。键 = 钩子名,可加一个状态后缀(:hover / :active / :focus / :disabled / :selected);值 = { 属性: 值 }。属性只认白名单、值按各自语法分词校验,不合法的条目丢弃并告警。钩子目录与语法见 docs/theme_interface.md §14。",
          "propertyNames": { "pattern": "^(app|header|main|filter-bar|page-title|card|card-title|stat-card|mini-stat|agent-card|chart-card|table-card|limit-card|settings-section|chart|tooltip|legend|table|table-head|table-row|button|button-primary|segmented|segmented-button|chip|badge|progress|progress-fill|switch|switch-thumb|input|empty-state)(:(hover|active|focus|disabled|selected))?$" },
          "additionalProperties": { "$ref": "#/definitions/cssBlock" }
        }
      }
    }
  }
}
